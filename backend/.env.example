# ====================================================================
# GramSeva — Backend Environment Variables
# ====================================================================

# Application
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo Mode (True = uses realistic mock fallback when Supabase/Gemini/Meta keys are not configured)
DEMO_MODE=True

# Supabase PostgreSQL Configuration
# Found in: Supabase Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Cloud API Configuration
# Get credentials from Meta for Developers: https://developers.facebook.com/
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-access-token
WHATSAPP_VERIFY_TOKEN=gramseva_webhook_secret_token_2026
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id

# ====================================================================
# Administrator Authentication & Security
# ====================================================================
PRIMARY_ADMIN_EMAIL=admin@gramseva.gov.in
PRIMARY_ADMIN_NAME="Panchayat Development Officer (PDO)"
PRIMARY_ADMIN_DEFAULT_PASSWORD=GramSeva@2026Secure!

# ====================================================================
# Live SMTP Email Delivery (Gmail)
# ====================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_google_app_password
SMTP_FROM="GramSeva Security <your_email@gmail.com>"
SMTP_USE_TLS=True
